⑦ 新規登録（本格版）
app.post("/register", async (req, res) => {

    const { email, password } = req.body;

    const exists = await User.findOne({ email });

    if (exists) {
        return res.status(400).json({ message: "既に登録済み" });
    }

    const newUser = new User({
        email,
        password,
        role: "user",
        useOtp: false
    });

    await newUser.save();

    res.json({ message: "登録成功" });
});
